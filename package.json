{
  "name": "@graph-giraffe/core",
  "version": "0.2.4",
  "description": "A GPU-accelerated, WebGL-powered node-editor library with custom texture and plugin-based custom node type support",
  "license": "MIT",
  "type": "module",
  "main": "./dist/graph-giraffe.cjs",
  "module": "./dist/graph-giraffe.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/graph-giraffe.js",
      "require": "./dist/graph-giraffe.cjs"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "node-editor",
    "graph",
    "webgl",
    "canvas",
    "visual-programming",
    "flow-editor",
    "dag",
    "webgl2"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HazelDaniel/graph-giraffe"
  },
  "scripts": {
    "build": "vite build && tsc && cp ./index.css dist/style.css",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "lite-server": "^2.6.1",
    "msdf-bmfont-xml": "^2.8.0",
    "typescript": "^5.0.4",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
